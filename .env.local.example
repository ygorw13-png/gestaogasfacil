
# Este é um arquivo de exemplo para configurar variáveis de ambiente locais
# Copie este arquivo para .env.local e preencha com seus valores
# O arquivo .env.local deve estar no .gitignore (já está por padrão no Vite)

# Supabase - Não é necessário para este projeto, pois já configurado no client.ts
# Apenas para referência em projetos futuros
VITE_SUPABASE_URL=sua_url_aqui
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# Outras APIs (adicione conforme necessário)
# VITE_API_XYZ_PUBLIC_KEY=sua_chave_publica_aqui
