# GásFácil — variáveis de ambiente (somente nomes e exemplos, sem segredos)
# Copie para .env e preencha. Nunca versione valores reais de chaves privadas.

# ── Frontend (Vite) ─────────────────────────────────────────────
# URL do backend (Lovable Cloud). No Lovable este valor é gerado automaticamente.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave PUBLICÁVEL (anon) do backend — é pública por natureza, mas não a copie de outro projeto.
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publicavel_aqui
# Identificador do projeto no backend.
VITE_SUPABASE_PROJECT_ID=seu_project_id
# Ações controladas do G1 (src/lib/g1/acoes.ts). Deixe "off" contra o banco publicado:
# ele ainda não tem as funções 003/004. Use "on" só no ambiente isolado de teste.
VITE_G1_ACOES=off

# ── Funções do backend (Deno) — configuradas como segredos no Cloud, não em .env ──
# Fornecidas pela plataforma: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# (a service-role key NÃO fica disponível no Lovable Cloud e nunca deve ir para o frontend).
# LOVABLE_API_KEY=gerenciada_pela_plataforma
# VAPID_PUBLIC_KEY=chave_publica_vapid
# VAPID_PRIVATE_KEY=chave_privada_vapid
# VAPID_SUBJECT=mailto:contato@exemplo.com
# G01_CREATE_BANNED_VALIDATED=   # deixar DESLIGADA; só ligar na implantação aprovada da G0.1
# Envio de WhatsApp (enviar-whatsapp) — hoje NÃO configurados no Cloud:
# EVOLUTION_API_URL=https://evolution.exemplo.com
# EVOLUTION_API_KEY=sua_chave
# EVOLUTION_INSTANCE=nome_instancia
# WHATSAPP_API_URL=https://api.exemplo.com
# WHATSAPP_API_KEY=sua_chave
# WHATSAPP_API_FORMAT=evolution
# TWILIO_API_KEY=sua_chave
# TWILIO_WHATSAPP_FROM=whatsapp:+5500000000000

# ── Laboratório (somente 127.0.0.1, dados fictícios) ────────────
# ISO_PG_URL=postgres://postgres@127.0.0.1:55440/postgres
# G1DB=/tmp/g1db
# G1_004=1   # run_permissoes.py: usa a regra C do 004 (troca só por reatribuição)
